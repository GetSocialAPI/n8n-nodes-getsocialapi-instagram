{
  "name": "n8n-nodes-getsocialapi-instagram",
  "version": "0.2.2",
  "description": "n8n community node for GetSocialAPI Instagram REST API",
  "license": "MIT",
  "homepage": "https://getsocialapi.com",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "getsocialapi",
    "instagram",
    "api",
    "data-extraction"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GetSocialAPI/n8n-nodes-getsocialapi-instagram.git"
  },
  "main": "dist/nodes/GetSocialApiInstagram/GetSocialApiInstagram.node.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/GetSocialApiInstagramApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GetSocialApiInstagram/GetSocialApiInstagram.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.23.0",
    "typescript": "^5.9.3",
    "eslint": "^9.39.1"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "author": {
    "name": "GetSocialAPI",
    "email": "hello@getsocialapi.com"
  }
}
